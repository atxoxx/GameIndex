{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameIndex",
  "version": "0.10.0",
  "identifier": "com.gameindex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameIndex",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "GameIndex",
        "url": "/splashscreen.html",
        "width": 520,
        "height": 360,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNkRDNzk5RTY3RDFDMzIKUldReUhIM21tY2R0enNBSlozWlVzclo4UWdwTVJ4T1NtakVaUk9icjNhRFlzOFVXSGRqc2xVN0IK",
      "endpoints": [
        "https://github.com/atxoxx/GameIndex/releases/latest/download/latest.json"
      ]
    }
  }
}
