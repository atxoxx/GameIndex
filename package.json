{
  "name": "gameindex",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "out/main/index.cjs",
  "description": "A unified game library application",
  "author": "GameIndex",
  "desktopName": "gameindex.desktop",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "tsc && vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "preview": "vite preview",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:plugins": "node scripts/lint-plugins.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.2.0",
    "parse-torrent": "^11.0.24",
    "quickjs-emscripten": "^0.32.0",
    "webtorrent": "^3.0.21"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "postcss": "^8.5.26",
    "source-map-js": "^1.2.2",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.11",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "hls.js": "^1.7.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.31.0",
    "nostr-tools": "^2.23.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
